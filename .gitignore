# Local environments, caches and host-specific inventory
.venv/
.local/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
build/
dist/
.DS_Store
.env
.env.*
!.env.example
.streamlit/secrets.toml
# Model weights and generated outputs are never ordinary Git content
*.ckpt
*.pt
*.pth
*.onnx
*.safetensors
models/weights/
outputs/
*.log
# Do not accidentally stage datasets or entire training runs
data/
training_output/
lightning_logs/
wandb/
# Transfer packages and historical audio belong in external staging, never Git.
*.wav
*.zip
*.tar
*.tar.gz
*.tgz
*.bundle
*-staging/

# Compiled training extensions (built by scripts/training/build_mas.sh).
*.so
*.pyd
vendor/piper/vits/monotonic_align/monotonic_align/
vendor/edgetts/vits/monotonic_align/monotonic_align/

# Original brand artwork stays local; published assets are hosted on Hugging Face.
/visual-branding/
